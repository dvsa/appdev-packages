{
  "name": "@dvsa/database-helpers",
  "version": "2.0.0",
  "description": "Common package to be used for database operations",
  "author": "DVSA",
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "https://github.com/dvsa/appdev-packages.git",
    "directory": "packages/database"
  },
  "files": [
    "session/**",
    "LICENSE",
    "package.json"
  ],
  "keywords": [
    "typescript",
    "nodejs"
  ],
  "scripts": {
    "build": "npm run clean && tsc",
    "clean": "rimraf coverage dist && npm run clean:temp",
    "clean:temp": "rimraf session",
    "gitSecrets": "git secrets --scan && git secrets --register-aws && git log -p --diff-filter=d -- . ':!*.json' -n 250 | scanrepo",
    "lint": "biome check src",
    "lint:fix": "npm run lint -- --write",
    "prepare": "husky",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "build:package": "npm run build",
    "prepublishOnly": "npm run build:package && cp -r ./dist/* . && rm -rf ./dist",
    "postpublish": "git clean -fd && npm run clean:temp"
  },
  "dependencies": {
    "class-transformer": "^0.5.1",
    "mybatis-mapper": "^0.8.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.1.3",
    "@dvsa/biome-config": "1.0.0",
    "@swc/core": "^1.16.2",
    "@swc/jest": "^0.2.39",
    "@types/aws-lambda": "^8.10.162",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.13.3",
    "@types/oracledb": "^6.5.4",
    "husky": "^9.1.7",
    "jest": "^30.4.2",
    "lint-staged": "^17.2.0",
    "mysql2": "^3.14.0",
    "oracledb": "^6.8.0",
    "rimraf": "^6.1.3",
    "ts-node": "^10.9.2",
    "typescript": "^7.0.2"
  },
  "lint-staged": {
    "*.{js,ts,mjs,css,md,ts,json}": "npm run lint:fix -- --no-errors-on-unmatched"
  }
}
