{
  "name": "@dvsa/service-bundler",
  "version": "4.0.0",
  "type": "commonjs",
  "author": "DVSA",
  "license": "ISC",
  "main": "index.cjs",
  "module": "index.mjs",
  "types": "index.d.cts",
  "exports": {
    ".": {
      "import": {
        "types": "./index.d.mts",
        "default": "./index.mjs"
      },
      "require": {
        "types": "./index.d.cts",
        "default": "./index.cjs"
      }
    },
    "./empty-module.js": "./empty-module.js",
    "./package.json": "./package.json"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/dvsa/appdev-packages.git",
    "directory": "packages/service-bundler"
  },
  "scripts": {
    "build": "npm run clean && tsdown && cp ./src/empty-module.ts ./dist/empty-module.js",
    "clean": "rimraf coverage dist && npm run clean:temp",
    "clean:temp": "rimraf api classes response",
    "gitSecrets": "git secrets --scan . && git log -p -- . | scanrepo",
    "lint": "biome check src",
    "lint:fix": "npm run lint -- --write",
    "prepare": "husky",
    "test": "echo \"*** Tests to be added\"",
    "test:coverage": "echo \"*** Tests to be added\"",
    "build:package": "npm run build",
    "prepublishOnly": "npm run build:package && cp -r ./dist/* . && rm -rf ./dist",
    "postpublish": "git clean -fd && npm run clean:temp"
  },
  "dependencies": {
    "@rspack/core": "2.1.8",
    "fs-extra": "^11.3.0",
    "val-loader": "^6.0.0",
    "zip-lib": "^1.1.2"
  },
  "devDependencies": {
    "@biomejs/biome": "2.1.3",
    "@dvsa/biome-config": "1.0.0",
    "@swc/core": "^1.15.46",
    "@swc/jest": "^0.2.39",
    "@types/fs-extra": "^11.0.4",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.13.3",
    "husky": "^9.1.7",
    "jest": "^30.4.2",
    "lint-staged": "^17.2.0",
    "rimraf": "^6.1.3",
    "ts-node": "^10.9.2",
    "tsdown": "^0.22.14",
    "typescript": "^7.0.2"
  },
  "lint-staged": {
    "*.{js,ts,mjs,css,md,ts,json}": "npm run lint:fix -- --no-errors-on-unmatched"
  }
}
