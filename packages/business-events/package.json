{
  "name": "@dvsa/business-events",
  "version": "2.0.0",
  "description": "A package to help manage business events in a domain context.",
  "author": "DVSA",
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "https://github.com/dvsa/appdev-packages.git",
    "directory": "packages/business-events"
  },
  "files": [
    "**.{js,ts}",
    "!jest.config.ts",
    "!src/__tests__/*.ts",
    "LICENSE",
    "package.json"
  ],
  "keywords": [
    "typescript",
    "nodejs"
  ],
  "scripts": {
    "build": "npm run clean && tsc",
    "clean": "rimraf coverage dist",
    "gitSecrets": "git secrets --scan && git secrets --register-aws && git log -p --diff-filter=d -- . ':!*.json' -n 250 | scanrepo",
    "lint": "biome check src",
    "lint:fix": "npm run lint -- --write",
    "prepare": "husky",
    "test": "jest --runInBand",
    "test:coverage": "jest --coverage",
    "build:package": "npm run build",
    "prepublishOnly": "npm run build:package && cp -r ./dist/* . && rm -rf ./dist",
    "postpublish": "git clean -fd"
  },
  "dependencies": {
    "@aws-sdk/client-sns": "^3.1127.0",
    "@aws-sdk/credential-providers": "^3.1127.0",
    "aws-xray-sdk": "^3.10.2"
  },
  "devDependencies": {
    "@biomejs/biome": "2.1.3",
    "@dvsa/biome-config": "1.0.0",
    "@swc/core": "^1.15.46",
    "@swc/jest": "^0.2.39",
    "@types/aws-lambda": "^8.10.162",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.13.3",
    "aws-sdk-client-mock": "^4.0.1",
    "aws-sdk-client-mock-jest": "^4.1.0",
    "husky": "^9.1.7",
    "jest": "^30.5.1",
    "jest-plugin-context": "^2.9.0",
    "lint-staged": "^17.2.0",
    "rimraf": "^6.1.3",
    "ts-node": "^10.9.2",
    "typescript": "^7.0.2"
  }
}
