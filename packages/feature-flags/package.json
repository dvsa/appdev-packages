{
  "name": "@dvsa/cvs-feature-flags",
  "version": "3.0.0",
  "description": "Common package to be used in CVS to manage feature flags",
  "author": "DVSA",
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "https://github.com/dvsa/appdev-packages.git",
    "directory": "packages/feature-flags"
  },
  "files": [
    "**.{js,ts}",
    "profiles/**",
    "LICENSE",
    "package.json",
    "!jest.config.ts",
    "!src/__tests__/*.ts"
  ],
  "keywords": [
    "typescript",
    "nodejs"
  ],
  "scripts": {
    "build": "npm run clean && tsc",
    "clean": "rimraf coverage dist && npm run clean:temp",
    "clean:temp": "rimraf profiles",
    "gitSecrets": "git secrets --scan && git secrets --register-aws && git log -p --diff-filter=d -- . ':!*.json' -n 250 | scanrepo",
    "lint": "biome check src",
    "lint:fix": "npm run lint -- --write",
    "prepare": "husky",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "build:package": "npm run build",
    "prepublishOnly": "npm run build:package && cp -r ./dist/* . && rm -rf ./dist",
    "postpublish": "git clean -fd && npm run clean:temp"
  },
  "dependencies": {
    "@aws-lambda-powertools/parameters": "^2.34.0",
    "lodash.merge": "^4.6.2"
  },
  "devDependencies": {
    "@biomejs/biome": "2.1.3",
    "@dvsa/biome-config": "1.0.0",
    "@aws-sdk/client-appconfigdata": "^3.1127.0",
    "@smithy/util-stream": "^3.0.1",
    "@swc/core": "^1.15.46",
    "@swc/jest": "^0.2.39",
    "@types/aws-lambda": "^8.10.162",
    "@types/jest": "^30.0.0",
    "@types/lodash.merge": "^4.6.9",
    "@types/node": "^24.13.3",
    "aws-sdk-client-mock": "^4.0.1",
    "aws-sdk-client-mock-jest": "^4.1.0",
    "husky": "^9.1.7",
    "jest": "^30.5.1",
    "lint-staged": "^17.2.0",
    "rimraf": "^6.1.3",
    "ts-node": "^10.9.2",
    "typescript": "^7.0.2"
  },
  "lint-staged": {
    "*.{js,ts,mjs,css,md,ts,json}": "npm run lint:fix -- --no-errors-on-unmatched"
  }
}
